    private static void printRowDashboard(int[][] arr, int starter) {
        for (int k = 0; k < 3; k++) {
            for (int i = starter; i < starter + 3; i++) {
                System.out.print("||\t");
                for (int j = 0; j < 3; j++) {
                    System.out.print(arr[i][j + (3 * k)] + "\t");
                }
                System.out.print("||\t");
            }
            System.out.println();

        }
    }

