package com.example.reda;

public class Classroom {
    private String className;
    private Teacher teacher;
    private Student[] students = new Student[0];

    public Classroom(String name, Teacher leadTeacher) {
        this.className = name;
        this.teacher = leadTeacher;
    }

    public String getClassName() {
        return className;
    }

    public void setClassName(String className) {
        this.className = className;
    }

    public Teacher getTeacher() {
        return teacher;
    }

    public void setTeacher(Teacher teacher) {
        this.teacher = teacher;
    }

    public boolean addStudent(Student student) {

        if (isExist(student))
            return false;

        Student[] arr1 = new Student[this.students.length + 1];
        for (int i = 0; i < this.students.length; i++) {
            arr1[i] = this.students[i];
        }

        this.students = arr1;

        return true;
    }

    private boolean isExist(Student student) {
        for (int i = 0; i < students.length; i++) {
            if (students[i].getID() == student.getID()) return true;
        }
        return false;
    }

    public boolean removeStudent(Student student) {
        boolean foundStudent = false;
        for (int i = 0; i < students.length; i++) {
            if (students[i].getID() == student.getID()) {
                foundStudent = true;
                break;
            }
        }

        Student[] arr2 = new Student[this.students.length - 1];
        int Index = 0;
        for (int i = 0; i < this.students.length; i++) {
            arr2[i] = this.students[i];
            if (students[i].getID() != student.getID()) {
                students[i] = arr2[i];
                Index++;
            }
        }

        arr2[arr2.length - 2] = student;
        this.students = arr2;

        return true;
    }

    public Student[] getStudents() {
        return students;
    }
}
